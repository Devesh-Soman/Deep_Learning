def name2tensor(name): return torch.tensor([all_letters.find(c) for c in name],dtype=torch.long).view(-1,1)
class RNN(nn.Module):
    def __init__(self,input_size,hidden_size,output_size):
        super().__init__(); self.hidden_size=hidden_size
        self.i2h=nn.Linear(input_size+hidden_size,hidden_size)
        self.i2o=nn.Linear(input_size+hidden_size,output_size)
        self.softmax=nn.LogSoftmax(dim=1)
    def forward(self,input,hidden):
        combined=torch.cat((input,hidden),1)
        hidden=torch.tanh(self.i2h(combined))
        output=self.softmax(self.i2o(combined)); return output,hidden
    def initHidden(self): return torch.zeros(1,self.hidden_size)
