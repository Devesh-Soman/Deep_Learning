import torch,torch.nn as nn,torch.optim as optim,unicodedata,string,random
all_letters=string.ascii_letters+" .,;'"; n_letters=len(all_letters)
def unicodeToAscii(s): return ''.join(c for c in unicodedata.normalize('NFD',s) if unicodedata.category(c)!='Mn' and c in all_letters)
categories=["English","French"]; n_categories=len(categories)
