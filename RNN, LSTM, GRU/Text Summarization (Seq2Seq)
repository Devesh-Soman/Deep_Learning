import tensorflow as tf
from tensorflow.keras.layers import Embedding,LSTM,Dense,Input
from tensorflow.keras.models import Model

enc_in=Input(shape=(None,)); emb=Embedding(5000,128)(enc_in)
enc_out, state_h, state_c = LSTM(256,return_state=True)(emb)
enc_states=[state_h,state_c]

dec_in=Input(shape=(None,))
dec_emb=Embedding(5000,128)(dec_in)
dec_lstm=LSTM(256,return_sequences=True,return_state=True)
dec_out,_,_=dec_lstm(dec_emb,initial_state=enc_states)
dec_dense=Dense(5000,activation="softmax")(dec_out)

model=Model([enc_in,dec_in],dec_dense)
model.compile(optimizer="adam",loss="sparse_categorical_crossentropy")
print("Seq2Seq LSTM summarizer model built ✅")
