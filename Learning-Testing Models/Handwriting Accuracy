import tensorflow as tf
import matplotlib.pyplot as plt

#get the data from the training set and test database
(train_images, train_labels), (test_images,test_labels)= tf.keras.datasets.mnist.load_data()

#training the images at 255.0px
train_images= train_images / 255.0
test_images= test_images / 255.0

#visualize data(Checking the amount of data we have)
print('Shape:',train_images.shape)
print('Labels:',train_labels.shape)
print('Test-Images:',test_images.shape)
print('Test-Labels:',test_labels.shape)

#display img at given position
plt.imshow(train_images[5], cmap='grey')

my_model= tf.keras.Sequential([
    tf.keras.layers.Flatten(input_shape=(28,28)),
    tf.keras.layers.Dense(128, activation='relu'),
    tf.keras.layers.Dense(10, activation='softmax')
])

my_model.compile(optimizer='adam',
                 loss='sparse_categorical_crossentropy',
                 metrics=['accuracy'])

my_model.fit(train_images,train_labels, epochs=10)

val_loss, val_acc= my_model.evaluate(test_images, test_labels)
print("test accuracy:",val_acc)

my_model.save('my_model.keras')
